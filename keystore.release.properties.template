# Release Keystore Configuration Template
# 
# Copy this file to keystore.release.properties and fill in your actual values.
# This file is gitignored for security reasons.
#
# To create a new keystore, run:
# keytool -genkey -v -keystore your-release-key.keystore -alias your-key-alias -keyalg RSA -keysize 2048 -validity 10000
#
# IMPORTANT: Keep your keystore file and passwords secure! If you lose them,
# you won't be able to update your app on Google Play.

storeFile=path/to/your/release-key.keystore
storePassword=your-store-password
keyAlias=your-key-alias
keyPassword=your-key-password

